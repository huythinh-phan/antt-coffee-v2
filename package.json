{
  "name": "antt-coffee-v3",
  "private": true,
  "version": "3.0.0",
  "description": "ANTT Coffee v3 - Fullstack Web Quản Lý & Bán Hàng Quán Cà Phê (Frontend Bootstrap 4 + Express Backend API)",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "build": "node -e \"import('node:fs').then(fs=>{fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('public','dist',{recursive:true});console.log('Built public/ -> dist/ successfully')})\"",
    "lint": "eslint server src --max-warnings=0",
    "test:unit": "vitest run",
    "test:e2e": "playwright test -c testsuite/e2e/playwright.config.js",
    "check": "npm run lint && npm run test:unit && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.5",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.50.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
