{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/menu", "destination": "/menu.html" },
    { "source": "/cart", "destination": "/cart.html" },
    { "source": "/order", "destination": "/menu.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/detail", "destination": "/detail.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/forget-password", "destination": "/forget-password.html" },
    { "source": "/history", "destination": "/history.html" },
    { "source": "/user", "destination": "/user.html" },
    { "source": "/account", "destination": "/user.html" },
    { "source": "/voucher", "destination": "/voucher.html" },
    { "source": "/gallery", "destination": "/gallery.html" },
    { "source": "/reviews", "destination": "/reviews.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(css|js|images|fonts)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
